---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilter from '../../components/blog/CategoryFilter.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import LoadMoreButton from '../../components/blog/LoadMoreButton.astro';
import Prompt from '../../components/terminal/Prompt.astro';
import { formatDate, calculateReadTimes } from '../../utils/helpers.ts';

const PAGE_SIZE = 10;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const sortedPosts = allPosts.sort((a, b) =>
  b.data.publish_date.getTime() - a.data.publish_date.getTime()
);

const categories = [...new Set(allPosts.map(post => post.data.category))].sort();
const initialPosts = sortedPosts.slice(0, PAGE_SIZE);

// All posts, for client-side category filtering and "load more".
const allPostsData = sortedPosts.map(post => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  image: post.data.image,
  isoDate: post.data.publish_date.toISOString(),
  date: formatDate(post.data.publish_date),
  readTime: calculateReadTimes(post.body ?? '')
}));
---

<BaseLayout
  pageTitle="Blog | Hadi Setiawan"
  description="Notes on Laravel, JavaScript, Docker and Linux servers from a full stack developer and server administrator."
>
  <div class="mx-auto max-w-5xl px-4 py-12 md:px-6">
    <header class="mb-8">
      <Prompt as="h1" cmd="ls" args="~/blog" />
      <p class="mt-2 text-ctp-subtext">Notes on web development and running servers. {allPosts.length} articles.</p>
    </header>

    <CategoryFilter categories={categories} />

    <div id="articles-container" class="grid gap-6 md:grid-cols-2">
      {initialPosts.map((post, index) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          author={post.data.author}
          publish_date={post.data.publish_date}
          category={post.data.category}
          tags={post.data.tags}
          image={post.data.image}
          slug={`blog/${post.id}`}
          content={post.body}
          loading={index < 4 ? 'eager' : 'lazy'}
        />
      ))}
    </div>

    <LoadMoreButton />
  </div>

  <script is:inline define:vars={{ allPostsData, PAGE_SIZE }}>
    let currentCategory = 'All';
    let shown = PAGE_SIZE;

    const container = document.getElementById('articles-container');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const buttons = document.querySelectorAll('.category-btn');

    const filtered = () => currentCategory === 'All'
      ? allPostsData
      : allPostsData.filter(post => post.category === currentCategory);

    const escape = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Mirrors src/components/blog/BlogCard.astro.
    function createPostElement(post) {
      const article = document.createElement('article');
      article.className = 'group';
      article.innerHTML = `
        <a href="/blog/${escape(post.slug)}" class="flex h-full flex-col overflow-hidden rounded-md border border-ctp-surface0 bg-ctp-mantle transition-colors hover:border-ctp-mauve">
          ${post.image ? `
            <div class="h-48 overflow-hidden border-b border-ctp-surface0">
              <img src="${escape(post.image)}" alt="${escape(post.title)}" width="400" height="200" loading="lazy" decoding="async"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </div>` : ''}
          <div class="flex flex-1 flex-col p-5">
            <p class="font-mono text-xs text-ctp-blue">${escape(post.category.toLowerCase())}/</p>
            <h3 class="mt-2 line-clamp-2 font-mono text-lg font-semibold text-ctp-text transition-colors group-hover:text-ctp-mauve">${escape(post.title)}</h3>
            <p class="mt-2 mb-4 line-clamp-3 text-ctp-subtext">${escape(post.description)}</p>
            <p class="mt-auto font-mono text-xs text-ctp-overlay">
              <time datetime="${post.isoDate}" class="text-ctp-peach">${escape(post.date)}</time> · ${post.readTime} min read
            </p>
          </div>
        </a>`;
      return article;
    }

    function updateLoadMore() {
      if (loadMoreBtn) loadMoreBtn.hidden = shown >= filtered().length;
    }

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        currentCategory = button.dataset.category;
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
        const posts = filtered().slice(0, PAGE_SIZE);
        container.replaceChildren(...posts.map(createPostElement));
        shown = posts.length;
        updateLoadMore();
      });
    });

    loadMoreBtn?.addEventListener('click', () => {
      const more = filtered().slice(shown, shown + PAGE_SIZE);
      container.append(...more.map(createPostElement));
      shown += more.length;
      updateLoadMore();
    });

    updateLoadMore();
  </script>
</BaseLayout>
