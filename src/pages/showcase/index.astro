---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prompt from "../../components/terminal/Prompt.astro";
import TerminalWindow from "../../components/terminal/TerminalWindow.astro";
import { projects } from "../../data/showcase";
---

<BaseLayout
  pageTitle="Showcase | Hadi Setiawan"
  description="Design-to-code portfolio: Figma UI designs sliced into responsive, fast landing pages."
>
  <div class="mx-auto max-w-5xl px-4 py-12 md:px-6">
    <header class="mb-8">
      <Prompt as="h1" cmd="ls" args="~/showcase" />
      <p class="mt-2 text-ctp-subtext">Figma designs sliced into responsive, fast landing pages.</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((project, index) => (
        <a href={`/showcase/${project.slug}`} class="group block">
          <TerminalWindow title={`~/showcase/${project.slug}`} bodyClass="" class="transition-colors group-hover:border-ctp-mauve">
            <Image
              src={project.thumbnail}
              alt={project.title}
              class="aspect-[16/10] w-full object-cover object-top"
              widths={[480, 800]}
              sizes="(min-width: 768px) 480px, 100vw"
              loading={index < 2 ? "eager" : "lazy"}
            />
            <div class="border-t border-ctp-surface0 p-4">
              <h2 class="font-mono font-semibold text-ctp-text group-hover:text-ctp-mauve">{project.title}</h2>
              <p class="mt-1 font-mono text-xs text-ctp-pink">
                {project.tags.map((t) => `#${t.toLowerCase().replaceAll(" ", "-")}`).join(" ")}
              </p>
            </div>
          </TerminalWindow>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
