---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Prompt from "../components/terminal/Prompt.astro";
import TerminalWindow from "../components/terminal/TerminalWindow.astro";
import { profile, highlights, achievements, skills } from "../data/profile";
import { projects } from "../data/showcase";
import { formatDate } from "../utils/helpers";

const latestPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publish_date.getTime() - a.data.publish_date.getTime())
  .slice(0, 3);

const section = "reveal mx-auto max-w-5xl px-4 py-12 md:px-6";
---

<BaseLayout
  pageTitle={`${profile.name} | Full Stack Web Developer & Server Administrator`}
  description="Full Stack Web Developer and Server Administrator in Semarang, Indonesia. 6+ years building Laravel and Node.js apps and running Linux servers. Open to work."
>
  <Hero />

  <!-- Highlights -->
  <section class={section} aria-labelledby="highlights">
    <Prompt id="highlights" cmd="cat" args="highlights.log" />
    <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-ctp-surface0 bg-ctp-surface0 md:grid-cols-3">
      {highlights.map((item) => (
        <div class="flex flex-col-reverse gap-1 bg-ctp-mantle p-4 md:p-5">
          <dt class="text-sm text-ctp-subtext">{item.label}</dt>
          <dd class="font-mono text-2xl font-bold text-ctp-peach tabular-nums md:text-3xl">
            <span class="sr-only">{item.value}</span>
            <span aria-hidden="true" data-scramble>{item.value}</span>
          </dd>
        </div>
      ))}
    </dl>
    <ul class="mt-6 space-y-2 text-ctp-subtext">
      {achievements.map((line) => (
        <li class="flex gap-3">
          <span class="font-mono text-ctp-green select-none" aria-hidden="true">→</span>
          <span>{line}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Skills -->
  <section class={section} aria-labelledby="skills">
    <Prompt id="skills" cmd="ls" args="./skills" />
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {skills.map((group) => (
        <div class="rounded-md border border-ctp-surface0 bg-ctp-mantle p-4">
          <h3 class="font-mono text-sm font-semibold">
            <span class="text-ctp-blue">{group.group}/</span>
            <span class="ml-2 font-normal text-ctp-overlay"># {group.label}</span>
          </h3>
          <ul class="mt-3 flex flex-wrap gap-1.5 font-mono text-xs">
            {group.items.map((item) => (
              <li class="rounded border border-ctp-surface0 bg-ctp-base px-2 py-1 text-ctp-text">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Showcase -->
  <section class={section} aria-labelledby="showcase">
    <div class="flex items-baseline justify-between gap-4">
      <Prompt id="showcase" cmd="ls" args="./showcase" />
      <a href="/showcase" class="shrink-0 font-mono text-sm text-ctp-mauve hover:underline">cd showcase →</a>
    </div>
    <p class="mt-2 text-ctp-subtext">Figma designs sliced into responsive, fast landing pages.</p>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <a href={`/showcase/${project.slug}`} class="group block">
          <TerminalWindow title={`~/showcase/${project.slug}`} bodyClass="" class="transition-colors group-hover:border-ctp-mauve">
            <Image src={project.thumbnail} alt={project.title} class="aspect-[16/10] w-full object-cover object-top" widths={[480, 800]} sizes="(min-width: 768px) 480px, 100vw" />
            <div class="border-t border-ctp-surface0 p-4">
              <h3 class="font-mono font-semibold text-ctp-text group-hover:text-ctp-mauve">{project.title}</h3>
              <p class="mt-1 font-mono text-xs text-ctp-pink">{project.tags.map((t) => `#${t.toLowerCase().replaceAll(" ", "-")}`).join(" ")}</p>
            </div>
          </TerminalWindow>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest writing -->
  <section class={section} aria-labelledby="writing">
    <div class="flex items-baseline justify-between gap-4">
      <Prompt id="writing" cmd="git log" args="-3 ./blog" />
      <a href="/blog" class="shrink-0 font-mono text-sm text-ctp-mauve hover:underline">cd blog →</a>
    </div>
    <ol class="mt-6 divide-y divide-ctp-surface0 rounded-md border border-ctp-surface0 bg-ctp-mantle">
      {latestPosts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group flex flex-col gap-1 p-4 transition-colors hover:bg-ctp-surface0/50 md:flex-row md:items-baseline md:gap-4">
            <time datetime={post.data.publish_date.toISOString()} class="shrink-0 font-mono text-xs text-ctp-peach md:w-36">
              {formatDate(post.data.publish_date)}
            </time>
            <div class="min-w-0">
              <h3 class="font-mono font-semibold text-ctp-text group-hover:text-ctp-mauve">{post.data.title}</h3>
              <p class="mt-1 line-clamp-2 text-sm text-ctp-subtext">{post.data.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Contact -->
  <section class={`${section} pb-20`} aria-labelledby="contact">
    <TerminalWindow title="~/contact.sh">
      <Prompt id="contact" cmd="./contact.sh" />
      <p class="mt-4 max-w-2xl text-ctp-subtext">
        Hiring for a web developer or server administrator role? Get the CV or send an email. Based in {profile.location}, open to remote.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 font-mono text-sm">
        <a href={profile.cv} download class="inline-flex items-center rounded bg-ctp-mauve px-4 py-2.5 font-semibold text-ctp-crust transition-opacity hover:opacity-90">
          Download CV
        </a>
        <a href={`mailto:${profile.email}`} class="inline-flex items-center rounded border border-ctp-surface1 px-4 py-2.5 text-ctp-text transition-colors hover:border-ctp-mauve hover:text-ctp-mauve">
          {profile.email}
        </a>
      </div>
    </TerminalWindow>
  </section>
  <script>
    // "Decrypt" effect for the highlight numbers: digits cycle randomly, then lock in left to
    // right. Bundled as a deferred module, so nothing runs while the HTML is parsed. Only digits
    // change and the font is monospaced, so the layout never shifts. Screen readers get the
    // sr-only copy; the animated text is aria-hidden.
    const targets = document.querySelectorAll<HTMLElement>("[data-scramble]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function scramble(el: HTMLElement, delay: number) {
      const final = el.textContent ?? "";
      const duration = 900;
      const tick = 45; // ms between updates: steppy like a terminal, and cheap
      let start: number | null = null;
      let last = 0;
      const frame = (now: number) => {
        if (start === null) start = now + delay;
        if (now < start) return requestAnimationFrame(frame);
        const t = Math.min(1, (now - start) / duration);
        if (now - last >= tick || t === 1) {
          last = now;
          const locked = Math.floor(t * final.length);
          el.textContent = [...final]
            .map((c, i) => (i < locked || !/\d/.test(c) ? c : String(Math.floor(Math.random() * 10))))
            .join("");
        }
        if (t < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }

    if (targets.length && !reduced && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.unobserve(entry.target);
            const index = [...targets].indexOf(entry.target as HTMLElement);
            scramble(entry.target as HTMLElement, (index % 3) * 120);
          }
        },
        { threshold: 0.6 },
      );
      targets.forEach((el) => io.observe(el));
    }
  </script>
</BaseLayout>
