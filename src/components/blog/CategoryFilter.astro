---
// Buttons only; filtering logic lives in src/pages/blog/index.astro.
export interface Props {
  categories: string[];
  currentCategory?: string;
}

const { categories, currentCategory = "All" } = Astro.props;
---

<div class="mb-8 overflow-x-auto pb-2">
  <div class="flex min-w-max gap-2 font-mono text-sm" role="group" aria-label="Filter by category">
    {["All", ...categories].map((category) => (
      <button
        type="button"
        data-category={category}
        aria-pressed={currentCategory === category ? "true" : "false"}
        class="category-btn rounded border border-ctp-surface0 px-3 py-1.5 whitespace-nowrap text-ctp-subtext transition-colors hover:border-ctp-mauve hover:text-ctp-mauve aria-pressed:border-ctp-mauve aria-pressed:bg-ctp-mauve aria-pressed:text-ctp-crust"
      >
        {category === "All" ? "*" : category.toLowerCase()}
      </button>
    ))}
  </div>
</div>
