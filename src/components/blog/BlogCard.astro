---
import { formatDate, calculateReadTimes } from "../../utils/helpers.ts";
import { Image } from "astro:assets";

export interface Props {
  title: string;
  description: string;
  author: string;
  publish_date: Date;
  category: string;
  tags: string[];
  image?: string;
  slug: string;
  featured?: boolean;
  content?: string;
  loading?: 'eager' | 'lazy';
}

const {
  title,
  description,
  publish_date,
  category,
  image,
  slug,
  content = "",
  loading = 'lazy'
} = Astro.props;

const readTime = calculateReadTimes(content);
---

<!-- Keep the markup in sync with createPostElement() in src/pages/blog/index.astro. -->
<article class="group">
  <a href={`/${slug}`} class="flex h-full flex-col overflow-hidden rounded-md border border-ctp-surface0 bg-ctp-mantle transition-colors hover:border-ctp-mauve">
    {image && (
      <div class="h-48 overflow-hidden border-b border-ctp-surface0">
        <Image
          src={image}
          alt={title}
          width={400}
          height={200}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading={loading}
          format="webp"
          quality={80}
          fetchpriority={loading === 'eager' ? 'high' : 'auto'}
        />
      </div>
    )}
    <div class="flex flex-1 flex-col p-5">
      <p class="font-mono text-xs text-ctp-blue">{category.toLowerCase()}/</p>
      <h3 class="mt-2 line-clamp-2 font-mono text-lg font-semibold text-ctp-text transition-colors group-hover:text-ctp-mauve">{title}</h3>
      <p class="mt-2 mb-4 line-clamp-3 text-ctp-subtext">{description}</p>
      <p class="mt-auto font-mono text-xs text-ctp-overlay">
        <time datetime={publish_date.toISOString()} class="text-ctp-peach">{formatDate(publish_date)}</time> · {readTime} min read
      </p>
    </div>
  </a>
</article>
