---
export interface Props {
  tags: string[];
  currentTag?: string;
}

const { tags, currentTag } = Astro.props;
---

<div class="flex flex-wrap gap-2 font-mono text-sm">
  {tags.map(tag => (
    <a
      href={`/tag/${tag}`}
      aria-current={currentTag === tag ? "page" : undefined}
      class="rounded border border-ctp-surface0 px-2.5 py-1 text-ctp-pink transition-colors hover:border-ctp-pink aria-[current=page]:bg-ctp-pink aria-[current=page]:text-ctp-crust"
    >
      #{tag}
    </a>
  ))}
</div>
