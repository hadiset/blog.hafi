---
const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
}

const links = [
  { href: "/", label: "~/" },
  { href: "/blog", label: "~/blog" },
  { href: "/showcase", label: "~/showcase" },
];
---

<nav class="sticky top-0 z-50 border-b border-ctp-surface0 bg-ctp-crust/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-4 md:px-6">
    <a href="/" class="font-mono text-sm font-semibold whitespace-nowrap" aria-label="Hadi Setiawan, home">
      <span class="text-ctp-green">hadi</span><span class="text-ctp-overlay">@</span><span class="text-ctp-mauve">hadiset</span><span class="text-ctp-overlay">:</span><span class="text-ctp-blue">~</span><span class="text-ctp-overlay">$</span>
    </a>

    <div class="hidden items-center gap-1 sm:flex">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class={`rounded px-3 py-1.5 font-mono text-sm transition-colors ${
            isActive(link.href)
              ? "bg-ctp-surface0 text-ctp-mauve"
              : "text-ctp-subtext hover:bg-ctp-surface0 hover:text-ctp-text"
          }`}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="theme-selector"
        class="flex size-9 items-center justify-center rounded border border-ctp-surface0 text-ctp-yellow transition-colors hover:border-ctp-surface1 hover:bg-ctp-surface0"
      >
        <span class="sr-only">Toggle light and dark mode</span>
        <!-- Sun: shown in dark mode -->
        <svg class="size-4 light:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <!-- Moon: shown in light mode -->
        <svg class="hidden size-4 text-ctp-mauve light:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <div id="mobile-menu-button" class="sm:hidden">
        <button
          type="button"
          class="flex size-9 items-center justify-center rounded border border-ctp-surface0 text-ctp-text hover:bg-ctp-surface0"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg id="open-menu-button" class="block size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
          <svg id="close-menu-button" class="hidden size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ctp-surface0 bg-ctp-crust sm:hidden">
    <div class="space-y-1 px-4 py-3">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class={`block rounded px-3 py-2 font-mono text-sm ${
            isActive(link.href) ? "bg-ctp-surface0 text-ctp-mauve" : "text-ctp-subtext hover:bg-ctp-surface0 hover:text-ctp-text"
          }`}
        >
          <span class="text-ctp-green">$ cd</span> {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  document.getElementById("theme-selector")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>
