---
// Floating pill bar modelled on Hadi's Waybar (Hyprland rice): separate rounded groups,
// base at 88% + blur, 1px surface0 border, accent color per item, solid mauve when active.
// 88% keeps every text color at WCAG AA even over white/black images (see docs/design-guide.md).
const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
}

const links = [
  { href: "/", label: "~/", accent: "text-ctp-blue" },
  { href: "/blog", label: "~/blog", accent: "text-ctp-pink" },
  { href: "/showcase", label: "~/showcase", accent: "text-ctp-peach" },
];

const pill =
  "pointer-events-auto flex h-11 items-center rounded-full border border-ctp-surface0 bg-ctp-base/88 px-1.5 backdrop-blur-md";
---

<nav aria-label="Main" class="site-nav pointer-events-none fixed inset-x-0 top-3 z-50">
  <!-- Same max-width and gutters as page sections, so pill edges line up with the content. -->
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-1.5 px-4 md:px-6">
    <!-- Brand: hidden on small screens so links and the theme toggle fit in one row. -->
    <div class={`${pill} hidden px-4 sm:flex`}>
      <a href="/" class="font-mono text-sm font-semibold whitespace-nowrap">
        <span class="text-ctp-green">hadi</span><span class="text-ctp-subtext">@</span><span class="text-ctp-mauve">hadiset</span><span class="text-ctp-subtext">:</span><span class="text-ctp-blue">~</span><span class="text-ctp-subtext">$</span><span class="sr-only"> Hadi Setiawan, home</span>
      </a>
    </div>

    <ul class={`${pill} gap-1.5 font-mono text-sm`}>
      {links.map((link) => {
        const active = isActive(link.href);
        return (
          <li>
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class={`flex h-8 items-center rounded-full transition-colors duration-200 ${
                active
                  ? "nav-active bg-ctp-mauve px-4 font-semibold text-ctp-crust"
                  : `px-3 ${link.accent} hover:bg-ctp-surface0`
              }`}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>

    <div class={pill}>
      <button
        type="button"
        id="theme-selector"
        class="flex size-8 items-center justify-center rounded-full text-ctp-yellow transition-colors duration-200 hover:bg-ctp-surface0"
      >
        <span class="sr-only">Toggle light and dark mode</span>
        <!-- Sun: shown in dark mode -->
        <svg class="size-4 light:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <!-- Moon: shown in light mode -->
        <svg class="hidden size-4 text-ctp-mauve light:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  document.getElementById("theme-selector")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>
