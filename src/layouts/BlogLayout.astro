---
import BaseLayout from "./BaseLayout.astro";
import { formatDate, calculateReadTimes } from "../utils/helpers";
import { Image } from "astro:assets";
import TagList from "../components/blog/TagList.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import type { MarkdownHeading } from "astro";

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    author: string;
    publish_date: Date;
    image?: string;
    imageAlt?: string;
    category?: string;
    tags?: string[];
  };
  content?: string;
  headings?: MarkdownHeading[];
}

const { frontmatter, content, headings = [] } = Astro.props;
const readTime = content ? calculateReadTimes(content) : 0;
---

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  articleDate={frontmatter.publish_date.toISOString()}
  author={frontmatter.author}
  crt={false}
>
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 lg:grid lg:grid-cols-[minmax(0,48rem)_15rem] lg:justify-center lg:gap-12">
  <article class="min-w-0">
    <header class="mb-10">
      <p class="font-mono text-sm">
        <a href="/blog" class="text-ctp-blue hover:underline">~/blog</a>{frontmatter.category && (
          <>
            <span class="text-ctp-overlay">/</span>
            <a href={`/category/${frontmatter.category}`} class="text-ctp-blue hover:underline">{frontmatter.category.toLowerCase()}</a>
          </>
        )}
      </p>

      <h1 class="mt-4 font-mono text-3xl leading-tight font-bold text-ctp-text md:text-4xl">
        {frontmatter.title}
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-ctp-subtext md:text-xl">
        {frontmatter.description}
      </p>

      <p class="mt-6 font-mono text-xs text-ctp-overlay">
        <span class="text-ctp-text">{frontmatter.author}</span>
        <span> · </span>
        <time datetime={frontmatter.publish_date.toISOString()} class="text-ctp-peach">{formatDate(frontmatter.publish_date)}</time>
        <span> · </span>
        <span>{readTime} min read</span>
      </p>

      {
        frontmatter.image && (
          <Image
            src={frontmatter.image}
            alt={frontmatter.imageAlt || frontmatter.title}
            width={800}
            height={400}
            class="mt-8 h-auto w-full rounded-md border border-ctp-surface0"
            loading="eager"
          />
        )
      }

      <div class="mt-8 lg:hidden">
        <TableOfContents headings={headings} variant="inline" />
      </div>
    </header>

    <div
      class="prose prose-lg max-w-none
        prose-headings:scroll-mt-20 prose-headings:font-mono prose-headings:font-semibold prose-headings:text-ctp-text
        prose-h2:mt-12 prose-h2:mb-5 prose-h2:text-2xl prose-h2:before:content-['##_'] prose-h2:before:text-ctp-mauve
        prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-xl prose-h3:before:content-['###_'] prose-h3:before:text-ctp-mauve
        prose-p:text-ctp-text prose-p:leading-8
        prose-li:text-ctp-text prose-li:marker:text-ctp-overlay
        prose-strong:text-ctp-text
        prose-a:text-ctp-mauve prose-a:no-underline hover:prose-a:underline
        prose-code:rounded prose-code:bg-ctp-surface0 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-sm prose-code:font-normal prose-code:text-ctp-peach prose-code:before:content-none prose-code:after:content-none
        prose-pre:rounded-md prose-pre:border prose-pre:border-ctp-surface0
        prose-blockquote:border-l-ctp-mauve prose-blockquote:text-ctp-subtext prose-blockquote:not-italic
        prose-hr:my-10 prose-hr:border-ctp-surface0
        prose-th:text-ctp-text prose-td:text-ctp-text prose-thead:border-ctp-surface1 prose-tr:border-ctp-surface0
        prose-img:mx-auto prose-img:rounded-md prose-img:border prose-img:border-ctp-surface0"
    >
      <slot />
    </div>

    {
      frontmatter.tags && frontmatter.tags.length > 0 && (
        <footer class="mt-12 border-t border-ctp-surface0 pt-8">
          <TagList tags={frontmatter.tags} />
        </footer>
      )
    }
  </article>

  <aside class="hidden lg:block">
    <TableOfContents headings={headings} variant="sidebar" />
  </aside>
  </div>
</BaseLayout>
